# ---------------------------------------------------------------
# Wedding Guest Registration System — environment configuration
# Copy this file to .env for local development. On Vercel, set these
# in Project → Settings → Environment Variables instead.
# ---------------------------------------------------------------

# Server (local development only — Vercel manages this itself)
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase connection string — REQUIRED.
# Supabase dashboard → Connect → "Transaction pooler" URI (port 6543).
# Example:
# DATABASE_URL=postgresql://postgres.abcdefghij:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to false ONLY for a local Postgres without TLS. Supabase needs TLS (leave unset).
# DATABASE_SSL=false

# Max pool connections per process/function instance (default 3).
# PG_POOL_MAX=3

# Session secret — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Regulator (door check-in) dashboard access password
REGULATOR_PASSWORD=change-me-regulator-password

# Optional: separate key for signing QR tickets (falls back to SESSION_SECRET).
# Set this so you can rotate SESSION_SECRET without invalidating
# already-issued QR codes.
# QR_SECRET=

# Optional overrides
# VERIFY_RATE_LIMIT=10

# Set to true when self-hosting over HTTPS (not needed on Vercel).
# COOKIE_SECURE=true
